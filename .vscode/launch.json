{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug vcut (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/vcut.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "build-debug",
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
